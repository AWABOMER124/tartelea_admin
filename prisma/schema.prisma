generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id         String   @id @default(uuid())
  full_name  String
  email      String   @unique
  role       String   @default("student") // admin, trainer, student
  points     Int      @default(0)
  level      Int      @default(1)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  workshops  Workshop[] @relation("TrainerWorkshops")
  enrolled   WorkshopEnrollment[]
}

model Workshop {
  id           String   @id @default(uuid())
  title        String
  description  String?
  scheduled_at DateTime
  status       String   @default("upcoming") // upcoming, live, completed
  trainer_id   String
  trainer      Profile  @relation("TrainerWorkshops", fields: [trainer_id], references: [id])
  students     WorkshopEnrollment[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model WorkshopEnrollment {
  id          String   @id @default(uuid())
  workshop_id String
  profile_id  String
  joined_at   DateTime @default(now())
  workshop    Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([workshop_id, profile_id])
}

model Content {
  id             String   @id @default(uuid())
  title          String
  description    String?
  type           String   // article, video, audio
  content_url    String?
  thumbnail_url  String?
  created_at     DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  body       String
  type       String   @default("system")
  status     String   @default("pending")
  send_at    DateTime?
  created_at DateTime @default(now())
}
